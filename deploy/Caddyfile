# HTTPS for the control site and every tenant site, issued on first visit.
# Caddy asks the control plane before each new certificate, so only real sites get one.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://{$CONTROL_SITE}:8080/api/method/saas_control.api.tls.allowed
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy frontend:8080 {
		header_up X-Forwarded-Proto https
	}
}

http:// {
	redir https://{host}{uri} permanent
}
