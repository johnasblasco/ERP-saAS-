# Copy to deploy/.env and fill in. Never commit the real file.
IMAGE=ghcr.io/your-org/erp-saas:latest

# The operator's admin site (plans, tenants, billing, signup page). Tenants get <name>.<root domain>
# as set in SaaS Settings; point both this name and *.<root domain> at the server.
CONTROL_SITE=admin.example.com
ACME_EMAIL=ops@example.com

DB_ROOT_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# Shared social apps (optional; can also be set per site in Social Integration Settings).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
