{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(uv run:*)",
      "Bash(bench --site * run-tests:*)",
      "Bash(bench --site * migrate)",
      "Bash(bench build:*)",
      "Bash(bench --site * console)"
    ],
    "ask": [
      "Bash(bench drop-site:*)",
      "Bash(bench --site * reinstall:*)",
      "Bash(bench --site * restore:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./frappe-bench/sites/*/site_config.json)",
      "Read(./frappe-bench/sites/common_site_config.json)"
    ]
  }
}
